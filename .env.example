DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

REUNI_SCHOOL="SMU Negeri 3 Cibatu"
REUNI_TARGET=25000000

